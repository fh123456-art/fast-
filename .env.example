# ===== App =====
APP_NAME=大学生求职与简历优化平台
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== Database (MySQL) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=job_resume_platform
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:123456@127.0.0.1:3306/job_resume_platform?charset=utf8mb4

# ===== JWT =====
JWT_SECRET_KEY=please-change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== LLM (DeepSeek via langchain-deepseek) =====
DEEPSEEK_API_KEY=sk-在platform.deepseek.com申请后填入
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Quota =====
DEFAULT_AI_QUOTA=100
DEFAULT_RESUME_LIMIT=5

# ===== Upload =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
