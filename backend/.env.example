# ========== 环境变量配置示例 ==========
# 使用方法:复制本文件并重命名为 .env,再填入你自己的值
# Windows:  copy .env.example .env
# Linux/Mac: cp .env.example .env

# 数据库连接(不配置则默认使用 SQLite,零配置即可启动)
# MySQL 示例:
# SQLALCHEMY_DATABASE_URL=mysql+pymysql://用户名:密码@localhost:3306/库名?charset=utf8mb4
SQLALCHEMY_DATABASE_URL=sqlite:///./fastapi.db

# JWT 密钥(生产环境请改成随机长字符串)
SECRET_KEY=please-change-this-to-a-random-secret

# 智谱 GLM 大模型(AI 简历解析/面试评分/岗位匹配/截图识别)
# Key 申请地址:https://open.bigmodel.cn/
ZHIPU_API_KEY=请替换为你自己的智谱APIKey
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash
ZHIPU_VISION_MODEL=glm-4v-plus
